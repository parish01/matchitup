# Copy this file to .env and fill in the Microsoft Foundry values below.
# With nothing set, MatchItUp runs in "template mode" (deterministic narratives, no AI model).

# --- Microsoft Foundry / Azure OpenAI ---
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
# Leave the key empty to use keyless Microsoft Entra ID auth (az login locally, managed identity on Azure).
# AZURE_OPENAI_API_KEY=

# --- Optional ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
# MATCH_SEED=8
# LLM_TIMEOUT_S=20
# LLM_MAX_CONCURRENCY=4
# PRICE_IN_PER_1M=     # optional, to show an estimated cost per card
# PRICE_OUT_PER_1M=
