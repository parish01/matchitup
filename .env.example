# Copy this file to .env and fill in ONE of the options below.
# With nothing set, MatchItUp runs in "template mode" (deterministic narratives, no AI model).

# --- Option A: Microsoft Foundry / Azure OpenAI (recommended for the submission) ---
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
# Leave the key empty to use keyless Microsoft Entra ID auth (az login locally, managed identity on Azure).
# AZURE_OPENAI_API_KEY=

# --- Option B: GitHub Models (free, for local development) ---
# LLM_PROVIDER=github
# GITHUB_MODELS_TOKEN=<fine-grained personal access token with "Models: read">
# GITHUB_MODEL=openai/gpt-4.1-mini

# --- Optional ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
# MATCH_SEED=8
# LLM_TIMEOUT_S=20
# LLM_MAX_CONCURRENCY=4
# PRICE_IN_PER_1M=     # optional, to show an estimated cost per card
# PRICE_OUT_PER_1M=
