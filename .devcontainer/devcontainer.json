{
  "name": "MatchItUp",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },
  "postCreateCommand": "pip install -r requirements-dev.txt",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "MatchItUp", "onAutoForward": "openBrowser" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "GitHub.copilot", "GitHub.copilot-chat", "ms-azuretools.vscode-azurecontainerapps"]
    }
  }
}
